  "rules": [
    {
      "id": "single-source-refs",
      "localImplementation": [
        "internal/assets/catalog.go:SingleSourceRefs",
        "internal/analysis/domain.go:sourceRefsActive",
        "internal/analysis/domain.go:Domain",
        "internal/analysis/queries.go:sourceReferences"
      ],
      "modelCondition": "Nonempty spec.sources uses activate ref declarations/mapping for length>1 on older pins, or length>=1 from 3.5.0. The product separately models a sole-source $ref use as unsupported before activation. spec.source is outside the product sources-ref domain.",
      "upstreamCondition": "GetRefSources allocates mappings, validates nonempty ref names with ^[a-zA-Z0-9_-]+$, and rejects duplicate keys only inside its len(sources) entry guard. GetRepoObjs calls it with the selected sources and current revisions; database access, downstream rendering and manifests are outside this static rule.",
      "rangeUniverse": "Known catalog versions only; not a forecast of future major versions.",
      "boundaries": [
        {
          "before": "3.4.13",
          "after": "3.5.0",
          "kind": "introduction",
          "change": "GetRefSources entry guard >1 becomes >0."
        }
      ],
